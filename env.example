# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored and must never be committed.

# ── App ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3005"

# ── Database (Phase 2) — Neon Postgres connection string ────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ── Auth.js (Phase 2) — generate with: openssl rand -base64 32 ──────
AUTH_SECRET=""

# ── Single admin account (Phase 7) — the only email granted ADMIN ───
ADMIN_EMAIL="sid.kumar2345@gmail.com"

# ── Brevo transactional email (Phase 2) ─────────────────────────────
BREVO_API_KEY=""
BREVO_SENDER_EMAIL=""
BREVO_SENDER_NAME="Mindful Journal"

# ── Google Gemini — free AI provider for the companion (https://aistudio.google.com → Get API key) ──
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"
